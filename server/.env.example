# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000
# Any MongoDB-compatible server. Atlas example:
# MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/lifeforjesus
MONGO_URL=mongodb://127.0.0.1:27017/lifeforjesus
# MONGO_URL=mongodb://127.0.0.1:27017/lifeforjesus
# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`). REQUIRED in production.
JWT_SECRET=change-me-in-development-only
# Comma-separated list of allowed browser origins when the client is hosted on a different domain.
CORS_ORIGIN=http://localhost:5173
# Cookies: set COOKIE_SECURE=true behind HTTPS. Use COOKIE_SAMESITE=none only for cross-site hosting (requires secure).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Development tools (ending trigger, time skip, state inspector). Always disabled when NODE_ENV=production.
DEV_TOOLS=true
# Serve the built client (client/dist) from this server — simplest single-host deployment.
SERVE_CLIENT=true
# Bible data file (public-domain World English Bible by default). Swap for another licensed translation.
BIBLE_DATA_FILE=data/web-bible.json
LOG_LEVEL=info
